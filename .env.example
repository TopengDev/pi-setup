# ──────────────────────────────────────────────────────────────────────────────
# pi environment — secrets template
#
# Copy to ~/.pi/agent/secrets.env and fill in real values.
# NEVER commit this file with real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ─── AI Provider Keys ────────────────────────────────────────────────────────
export DEEPSEEK_API_KEY=""
export ANTHROPIC_API_KEY=""
export OPENAI_API_KEY=""

# ─── Google AI Studio (image generation, Gemini) ─────────────────────────────
export GEMINI_API_KEY=""

# ─── GitHub ──────────────────────────────────────────────────────────────────
# Classic PAT with repo scope
export GH_TOKEN=""

# ─── Remote Control Stack (pi-remote + attn-agnostic) ────────────────────────
# Only needed if you ran: ./install.sh --remote-stack
#
# TELEGRAM_BOT_TOKEN — from @BotFather on Telegram (/newbot)
# SUPERUSER_TG_ID    — your numeric Telegram user ID (message @userinfobot)
# PI_ADDRESS         — your attnd Ethereum address (run: attn status)
# ATTN_SESSION       — session label shown in the attn network (e.g. "pi")
export TELEGRAM_BOT_TOKEN=""
export SUPERUSER_TG_ID=""
export PI_ADDRESS=""
export ATTN_SESSION="pi"

# ─── Infrastructure ──────────────────────────────────────────────────────────
# Cloudflare DNS
export CLOUDFLARE_API_TOKEN=""
export CLOUDFLARE_ZONE_ID=""

# VPS
export VPS_HOST=""
export VPS_USER=""
export VPS_PASSWORD=""
